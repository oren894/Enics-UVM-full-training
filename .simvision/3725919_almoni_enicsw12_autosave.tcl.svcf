#
# Source Browser windows
#
if {[catch {window new SrcBrowser -name "Source Browser 1" -geometry 905x447+-144+753}] != ""} {
    window geometry "Source Browser 1" 905x447+-144+753
}
window target "Source Browser 1" on
srcbrowser using {Source Browser 1}
srcbrowser set \
    -primarycursor TimeA \
    -units ns \
    -radix default \
    -showstrength 0 \
    -showcallstack 0 \
    -displayvalues 1

srcbrowser show -scope worklib.dma_crc_pkg::crc_check_analyze_word_generic -file /project/test_project/users/almoni/ws/uvm-env/rx_new2/rtl/dma_crc_pkg.sv -line 201

srcbrowser sidebar visibility partial

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+0

