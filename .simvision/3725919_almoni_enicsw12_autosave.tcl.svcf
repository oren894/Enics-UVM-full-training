
#
# Preferences
#
preferences set txe-locate-add-fibers 1
preferences set signal-type-colors {assertion #FF0000 output #FFA500 group #0099FF inout #00FFFF input #FFFF00 fiber #00EEEE errorsignal #FF0000 unknown #FFFFFF overlay #0099FF internal #00FF00 reference #FFFFFF}
preferences set txe-navigate-search-locate 0
preferences set txe-view-hold 0
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-SimControl-WaveWindow {
  usual
  position -anchor e
}
preferences set verilog-colors {Su #ff0099 0 {} 1 {} HiZ #ff9900 We #00ffff Pu #9900ff Sm #00ff99 X #ff0000 StrX #ff0000 other #ffff00 Z #ff9900 Me #0000ff La #ff00ff St {}}
preferences set txe-navigate-waveform-locate 1
preferences set txe-view-hidden 0
preferences set txe-search-show-linenumbers 1
preferences set toolbar-txe_waveform_toggle-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set key-bindings {PageUp PageUp Edit>Undo Ctrl+z View>Zoom>In Alt+i View>Zoom>Next {Alt+Right arrow} PageDown PageDown ScrollDown {Down arrow} Edit>Copy Ctrl+c Edit>Select>All Ctrl+a Simulation>NextInScope F7 View>Zoom>FullY_widget y Edit>Create>Group Ctrl+g Format>Radix>Decimal Ctrl+Shift+D Edit>Ungroup Ctrl+Shift+G TopOfPage Home Edit>Create>Condition Ctrl+e {command -console SimVision {%w sidebar access designbrowser selectall}} Alt+a ScrollLeft {Left arrow} Edit>SelectAllText Alt+a Edit>TextSearchConsole Alt+s View>Zoom>FullX_widget = Windows>SendTo>Waveform Ctrl+w Simulation>Return Shift+F5 View>CallstackDown {Ctrl+Down arrow} Select>All Ctrl+a Edit>Delete Del Format>Radix>Octal Ctrl+Shift+O Edit>Cut Ctrl+x Simulation>Run F2 Edit>Create>Marker Ctrl+m View>Center Alt+c View>CallstackInWindow Ctrl+k Edit>SelectAll Ctrl+a File>OpenDatabase Ctrl+o Edit>Redo Ctrl+y Format>Radix>Binary Ctrl+Shift+B View>ExpandSequenceTime>AtCursor Alt+x ScrollUp {Up arrow} File>CloseWindow Ctrl+Shift+W ScrollRight {Right arrow} View>Zoom>FullX Alt+= Edit>Create>Bus Ctrl+b Explore>NextEdge Ctrl+\],\] View>Zoom>Cursor-Baseline Alt+z View>Zoom>OutX Alt+o Edit>GoToLine Ctrl+g View>ShowScrollplate {} Help>Crossselection Ctrl+0 View>Zoom>Fit Alt+= View>Zoom>OutX_widget o View>CallstackUp {Ctrl+Up arrow} View>Bookmarks>Add Ctrl+b Format>Radix>Hexadecimal Ctrl+Shift+H Edit>Search Ctrl+f Simulation>Next F6 View>ShowValues Ctrl+s View>Zoom>InX Alt+i Edit>Create>MarkerAtCursor Ctrl+Shift+M View>Zoom>Out Alt+o Edit>TextSearch Ctrl+f Format>Signed Ctrl+Shift+S Edit>Paste Ctrl+v View>Zoom>Previous {Alt+Left arrow} View>CollapseSequenceTime>AtCursor Alt+s Format>Radix>ASCII Ctrl+Shift+A View>Zoom>InX_widget i BottomOfPage End Explore>PreviousEdge {Ctrl+[,[} Simulation>Step F5}
preferences set sb-display-values 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-Windows-WaveWindow {
  usual
  position -pos 2
}
preferences set txe-navigate-waveform-next-child 1
preferences set vhdl-colors {H #00ffff L #00ffff 0 {} X #ff0000 - {} 1 {} U #9900ff Z #ff9900 W #ff0000}
preferences set txe-locate-scroll-x 1
preferences set txe-locate-scroll-y 1
preferences set savedlg-simulator ppe
preferences set txe-locate-pop-waveform 1
preferences set key-bindings {Edit>Undo Ctrl+z PageUp PageUp View>Zoom>Next {Alt+Right arrow} View>Zoom>In Alt+i PageDown PageDown Edit>Copy Ctrl+c ScrollDown {Down arrow} Edit>Create>Group Ctrl+g View>Zoom>FullY_widget y Simulation>NextInScope F7 Edit>Select>All Ctrl+a Format>Radix>Decimal Ctrl+Shift+D Edit>Ungroup Ctrl+Shift+G TopOfPage Home Edit>Create>Condition Ctrl+e {command -console SimVision {%w sidebar access designbrowser selectall}} Alt+a ScrollLeft {Left arrow} Edit>SelectAllText Alt+a Edit>TextSearchConsole Alt+s View>Zoom>FullX_widget = Windows>SendTo>Waveform Ctrl+w Simulation>Return Shift+F5 View>CallstackDown {Ctrl+Down arrow} Select>All Ctrl+a Edit>Delete Del Format>Radix>Octal Ctrl+Shift+O Edit>Cut Ctrl+x Simulation>Run F2 Edit>Create>Marker Ctrl+m View>Center Alt+c View>CallstackInWindow Ctrl+k Edit>SelectAll Ctrl+a File>OpenDatabase Ctrl+o Edit>Redo Ctrl+y Format>Radix>Binary Ctrl+Shift+B View>ExpandSequenceTime>AtCursor Alt+x ScrollUp {Up arrow} File>CloseWindow Ctrl+Shift+W ScrollRight {Right arrow} View>Zoom>FullX Alt+= Edit>Create>Bus Ctrl+b Explore>NextEdge Ctrl+\],\] View>Zoom>Cursor-Baseline Alt+z View>Zoom>OutX Alt+o Edit>GoToLine Ctrl+g View>Zoom>OutX_widget o View>ShowScrollplate {} Help>Crossselection Ctrl+0 View>Zoom>Fit Alt+= View>CallstackUp {Ctrl+Up arrow} View>Bookmarks>Add Ctrl+b View>ShowValues Ctrl+s Simulation>Next F6 Edit>Search Ctrl+f Format>Radix>Hexadecimal Ctrl+Shift+H Edit>Create>MarkerAtCursor Ctrl+Shift+M View>Zoom>InX Alt+i View>Zoom>Out Alt+o Edit>TextSearch Ctrl+f View>Zoom>Previous {Alt+Left arrow} Edit>Paste Ctrl+v Format>Signed Ctrl+Shift+S View>CollapseSequenceTime>AtCursor Alt+s View>Zoom>InX_widget i Format>Radix>ASCII Ctrl+Shift+A Simulation>Step F5 Explore>PreviousEdge {Ctrl+[,[} BottomOfPage End}

#
# Databases
#
database require dump -search {
	./runspace/dump/dump.trn
	/project/test_project/users/almoni/ws/uvm-env/rx_new2/runspace/dump/dump.trn
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1918x1000+0+25}] != ""} {
    window geometry "Waveform 1" 1918x1000+0+25
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 226 \
    -units ns \
    -valuewidth 222
waveform baseline set -time 0

set id [waveform add -signals  {
	{dump::$uvm:{uvm_test_top.environment.reference_model}}
	} ]
set id [waveform add -signals  {
	{dump::$uvm:{uvm_test_top.environment.reference_model}.reference_model.current_lock_state}
	} ]
waveform format $id -color #ff9900
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.fsm_current_state[2:0]}
	} ]
waveform format $id -color #ff9900
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.aligned_data_internal_s0[3:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.clk
	} ]
waveform format $id -color #666666 -namecolor #666666
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.data_nibble_counter[16:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.detected_phase[1:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.detected_phase_comb[1:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.fsm_is_locked
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.in_aligned_data[3:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.input_data[3:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.input_valid
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_any_valid
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_crc_analysis
	} ]
waveform hierarchy expand $id
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_crc_field_one_error
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_crc_ok_or_fixed
	} ]
set id [waveform add -signals  {
	{dump::$uvm:{uvm_test_top.environment.reference_model}.reference_model.expected_msg_length}
	} ]
waveform format $id -radix %x -color #0099ff
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.len_extracted_length[15:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_fix_ok
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_multibit_error
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.len_sliding_window[34:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_len_detect.len_sliding_window_next[34:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_valid_offset_0
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_valid_offset_1
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_valid_offset_2
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.len_valid_offset_3
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.phase_data_length_end
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_len_detect.rst_n
	} ]

waveform xview limits 3837376.859ns 3837413.141ns

if {[catch {window new WaveWindow -name "Waveform 2" -geometry 1918x1000+0+25}] != ""} {
    window geometry "Waveform 2" 1918x1000+0+25
}
waveform using {Waveform 2}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 247 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.clk
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.data_next_nibble_counter[16:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.data_packet_length[15:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.fsm_current_state[2:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.fsm_next_state[2:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_control_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_control_end
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_control_start
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_end
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_length_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_length_end
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_length_start
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_data_start
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_next_control_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_next_data_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_next_data_length_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_next_parity_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_parity_active
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_parity_end
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.phase_parity_start
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.phase_state[2:0]}
	} ]
set id [waveform add -signals  {
	{dump::rx_top_tb.dut.u_phase_ctrl.phase_state_next[2:0]}
	} ]
set id [waveform add -signals  {
	dump::rx_top_tb.dut.u_phase_ctrl.rst_n
	} ]

waveform xview limits 3837039.029ns 3837147.208ns

#
# Waveform Window Links
